@startuml class-1-agent-core
title Class Diagram (1/3) — Agent core, tools and LLM layer
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontSize 12
left to right direction
hide empty members

package "agent" {
  class AgentController {
    - llm : LLMClient
    - tools : ToolRegistry
    - prompts : PromptBuilder
    - listeners : List<AgentEventListener>
    - maxSteps : int
    + run(goal : AgentGoal, q : QuestionHandler) : AgentResult
    + addListener(l : AgentEventListener) : void
    - step(s : AgentSession) : LlmResponse
    - notifyToolCalled(c : ToolCall) : void
    - notifyFinished(r : AgentResult) : void
  }
  class AgentGoal {
    - type : GoalType
    - posting : Posting
    - constraints : List<String>
  }
  enum GoalType {
    TAILOR_RESUME
    FIT_ONE_PAGE
  }
  class AgentSession {
    - goal : AgentGoal
    - messages : List<Message>
    - draft : Resume
    - toolLog : List<ToolCall>
    - stepCount : int
    - questionHandler : QuestionHandler
    + addMessage(m : Message) : void
    + updateDraft(r : Resume) : void
  }
  class Message {
    - role : Role
    - content : String
  }
  class AgentResult {
    - status : ResultStatus
    - resume : Resume
    - summary : String
    - steps : int
  }
  enum ResultStatus {
    COMPLETED
    STEP_LIMIT
    FAILED
  }
  class PromptBuilder {
    - rules : List<String>
    + buildSystemPrompt(g : AgentGoal) : String
    + buildRequest(s : AgentSession, schemas : List<ToolSchema>) : LlmRequest
  }
  interface AgentEventListener <<Observer>> {
    + onToolCalled(c : ToolCall) : void
    + onToolResult(r : ToolResult) : void
    + onFinished(r : AgentResult) : void
  }
  interface QuestionHandler {
    + ask(question : String) : Optional<String>
  }
}

package "agent.tools" {
  class ToolRegistry {
    - tools : Map<String, Tool>
    + register(t : Tool) : void
    + schemas() : List<ToolSchema>
    + execute(c : ToolCall, s : AgentSession) : ToolResult
    - validateArgs(t : Tool, args : JsonNode) : List<String>
  }
  interface Tool {
    + name() : String
    + description() : String
    + schema() : ToolSchema
    + execute(args : JsonNode, s : AgentSession) : ToolResult
  }
  class ToolSchema {
    - name : String
    - description : String
    - inputSchema : JsonNode
  }
  class ToolCall {
    - id : String
    - name : String
    - args : JsonNode
  }
  class ToolResult {
    - ok : boolean
    - content : String
    - error : String
  }
  class ParsePostingTool
  class SearchVaultTool
  class FindSimilarResumeTool
  class KeywordScanTool
  class ComposeResumeTool
  class EstimatePageTool
  class CondenseTool
  class AskUserTool
  class SaveResumeTool
}

package "llm" {
  interface LLMClient <<Target>> {
    + complete(req : LlmRequest) : LlmResponse
    + modelName() : String
  }
  class ClaudeAdapter <<Adapter>> {
    - sdk : AnthropicClient
    - model : String
    + complete(req : LlmRequest) : LlmResponse
    - toProvider(req : LlmRequest) : MessageCreateParams
    - fromProvider(m : ProviderMessage) : LlmResponse
  }
  class OpenAiCompatibleAdapter <<Adapter>> {
    - baseUrl : String
    - model : String
    + complete(req : LlmRequest) : LlmResponse
  }
  class AnthropicClient <<external SDK>>
  class LlmRequest {
    - system : String
    - messages : List<Message>
    - tools : List<ToolSchema>
    - maxTokens : int
  }
  class LlmResponse {
    - text : String
    - toolCalls : List<ToolCall>
    - stopReason : String
    + hasToolCalls() : boolean
  }
  abstract class "LlmTask<T>" as LlmTask <<Template Method>> {
    # llm : LLMClient
    - maxRetries : int
    + run() : T {final}
    # {abstract} buildRequest() : LlmRequest
    # {abstract} parse(r : LlmResponse) : T
    # validate(result : T) : List<String>
  }
  class PostingAnalysisTask
  class CoverLetterTask
  class RevisionTask
  class SmartCondenseTask
}

AgentController "1" o-- "1" ToolRegistry
AgentController "1" --> "1" LLMClient
AgentController --> PromptBuilder
AgentController "1" --> "*" AgentEventListener : notifies >
AgentController ..> AgentSession : <<creates>>
AgentController ..> AgentResult : <<returns>>
AgentGoal --> GoalType
AgentResult --> ResultStatus
AgentSession "1" *-- "*" Message
AgentSession --> "1" AgentGoal
AgentSession --> QuestionHandler

ToolRegistry "1" o-- "1..*" Tool
ToolRegistry ..> ToolCall
Tool ..> ToolResult
Tool ..> ToolSchema
Tool <|.. ParsePostingTool
Tool <|.. SearchVaultTool
Tool <|.. FindSimilarResumeTool
Tool <|.. KeywordScanTool
Tool <|.. ComposeResumeTool
Tool <|.. EstimatePageTool
Tool <|.. CondenseTool
Tool <|.. AskUserTool
Tool <|.. SaveResumeTool

LLMClient <|.. ClaudeAdapter
LLMClient <|.. OpenAiCompatibleAdapter
ClaudeAdapter --> AnthropicClient : adapts >
LLMClient ..> LlmRequest
LLMClient ..> LlmResponse
LlmResponse "1" *-- "*" ToolCall
LlmTask --> LLMClient
LlmTask <|-- PostingAnalysisTask
LlmTask <|-- CoverLetterTask
LlmTask <|-- RevisionTask
LlmTask <|-- SmartCondenseTask
ParsePostingTool --> PostingAnalysisTask
AskUserTool ..> QuestionHandler

note as ToolNote
  Tools delegate to deterministic services
  (see class diagram 2/3):
  SearchVaultTool -> VaultService
  FindSimilarResumeTool -> ResumeLibrary
  KeywordScanTool -> KeywordScanner
  ComposeResumeTool -> LatexAssembler
  EstimatePageTool -> PageEstimator
  CondenseTool -> CondenseStrategy
  SaveResumeTool -> ResumeRepository
  AskUserTool -> VaultService.fileAnswer()
end note
@enduml
