@startuml class-2-domain-services
title Class Diagram (2/3) — Domain model and deterministic services
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontSize 12
left to right direction
hide empty members
skinparam nodesep 25
skinparam ranksep 40

package "domain" {
  class Posting {
    - id : String
    - company : String
    - role : String
    - rawText : String
    - term : String
    - deadline : LocalDate
    - analysis : PostingAnalysis
  }
  class PostingAnalysis {
    - mustHaves : List<String>
    - niceToHaves : List<String>
    - keywords : List<Keyword>
    - documentsRequired : List<String>
    - softSkillFocus : boolean
  }
  class Keyword {
    - term : String
    - aliases : Set<String>
    - mustHave : boolean
  }
  class VaultEntry {
    - id : String
    - title : String
    - kind : EntryKind
    - use : EntryUse
    - date : String
    - tags : Set<String>
    - body : String
  }
  enum EntryKind {
    PROJECT
    WORK
    COURSE
    ACTIVITY
    SKILL
    PLANNED
  }
  enum EntryUse {
    ALL
    LETTERS_ONLY
    CONTEXT_ONLY
  }
  class ResumeBlock {
    - id : String
    - section : Section
    - title : String
    - startDate : YearMonth
    - endDate : YearMonth
    - bullets : List<String>
    - tags : Set<String>
  }
  enum Section {
    EDUCATION
    EXPERIENCE
    PROJECTS
    LEADERSHIP
    SKILLS
  }
  class Resume {
    - id : String
    - name : String
    - family : String
    - blocks : List<ResumeBlock>
    - latex : String
    + copy() : Resume
    + blocksIn(s : Section) : List<ResumeBlock>
    + hasPlaceholders() : boolean
  }
  class CoverLetter {
    - name : String
    - postingId : String
    - body : String
  }
  class FitReport {
    - score : int
    - matched : List<String>
    - gaps : List<String>
    - strategy : TailorStrategy
    - closest : ResumeMatch
  }
  enum TailorStrategy {
    REUSE
    TWEAK
    GENERATE
  }
  class ResumeMatch {
    - resume : Resume
    - matchPercent : int
  }
  class KeywordReport {
    - backed : List<Keyword>
    - thin : List<Keyword>
    - knownNotWorded : List<Keyword>
    - missing : List<Keyword>
    + coverage() : double
  }
}

package "service" {
  class VaultService {
    - repo : VaultRepository
    + search(query : String, tags : Set<String>) : List<VaultEntry>
    + addEntry(e : VaultEntry) : void
    + fileAnswer(question : String, answer : String) : VaultEntry
    + skills() : Set<String>
  }
  class LatexResumeParser {
    + parse(latex : String) : ParseResult
    - parseEntry(cmd : String) : ResumeBlock
  }
  class LatexAssembler {
    - template : String
    + assemble(r : Resume) : String
    - orderReverseChronological(blocks : List<ResumeBlock>) : List<ResumeBlock>
    - stripBold(s : Section, text : String) : String
  }
  class FitScorer {
    + score(a : PostingAnalysis, skills : Set<String>) : FitReport
  }
  class KeywordScanner {
    - vault : VaultService
    + scan(r : Resume, a : PostingAnalysis) : KeywordReport
  }
  class PageEstimator {
    - linesPerPage : int
    + estimate(r : Resume) : double
    + fitsOnePage(r : Resume) : boolean
  }
  interface CondenseStrategy <<Strategy>> {
    + condense(r : Resume, a : PostingAnalysis, p : PageEstimator) : Resume
  }
  class RuleBasedCondense {
    - steps : List<CondenseStep>
    + condense(...) : Resume
  }
  class LlmCondense {
    - task : SmartCondenseTask
    + condense(...) : Resume
  }
  class ResumeLibrary {
    - repo : ResumeRepository
    + findClosest(a : PostingAnalysis) : Optional<ResumeMatch>
    + groupByFamily() : Map<String, List<Resume>>
  }
  class RevisionHistory <<Invoker>> {
    - undoStack : Deque<ResumeEditCommand>
    - redoStack : Deque<ResumeEditCommand>
    + execute(c : ResumeEditCommand) : Resume
    + undo() : Resume
    + redo() : Resume
  }
  interface ResumeEditCommand <<Command>> {
    + execute() : Resume
    + undo() : Resume
    + describe() : String
  }
  class AiRevisionCommand {
    - before : Resume
    - after : Resume
    - instruction : String
    - task : RevisionTask
  }
  class ReplaceBulletCommand {
    - blockId : String
    - index : int
    - oldText : String
    - newText : String
  }
  class RemoveBlockCommand {
    - block : ResumeBlock
    - position : int
  }
  class ExportService {
    + fileName(prefix : String, company : String, role : String) : String
    + exportLatex(r : Resume, dir : Path) : Path
    + exportCoverLetter(c : CoverLetter, dir : Path) : Path
  }
}

Posting "1" *-- "0..1" PostingAnalysis
PostingAnalysis "1" *-- "*" Keyword
VaultEntry --> EntryKind
VaultEntry --> EntryUse
ResumeBlock --> Section
Resume "1" o-- "1..*" ResumeBlock
FitReport --> TailorStrategy
FitReport --> "0..1" ResumeMatch
ResumeMatch --> Resume
KeywordReport --> "*" Keyword

VaultService "1" --> "*" VaultEntry : manages >
LatexResumeParser ..> ResumeBlock : <<creates>>
LatexAssembler ..> Resume
FitScorer ..> FitReport : <<creates>>
KeywordScanner ..> KeywordReport : <<creates>>
KeywordScanner --> VaultService
PageEstimator ..> Resume
CondenseStrategy <|.. RuleBasedCondense
CondenseStrategy <|.. LlmCondense
CondenseStrategy ..> PageEstimator
ResumeLibrary ..> ResumeMatch : <<creates>>
RevisionHistory "1" o-- "*" ResumeEditCommand
ResumeEditCommand <|.. AiRevisionCommand
ResumeEditCommand <|.. ReplaceBulletCommand
ResumeEditCommand <|.. RemoveBlockCommand
ExportService ..> Resume
ExportService ..> CoverLetter
@enduml
