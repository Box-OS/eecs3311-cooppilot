@startuml use-case
title Use-Case Diagram — CoopPilot
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontSize 12

actor Student as S
actor "LLM Service\n(Claude API)" as LLM <<external service>>
actor "Local File System\n(LaTeX / Overleaf)" as FS <<external>>

rectangle "CoopPilot (GUI + CLI)" {
  usecase "UC01 Manage Experience Vault" as UC01
  usecase "UC02 Import Job Posting" as UC02
  usecase "UC03 Review Fit and\nKeyword Coverage" as UC03
  usecase "UC04 Tailor Resume with Agent" as UC04
  usecase "UC05 Fit Resume to One Page" as UC05
  usecase "UC06 Answer Clarifying Question" as UC06
  usecase "UC07 Revise Resume in\nNatural Language" as UC07
  usecase "UC08 Draft Cover Letter" as UC08
  usecase "UC09 Reuse or Export Resume" as UC09
  usecase "UC10 Track Application" as UC10
  usecase "UC11 View Progress Dashboard" as UC11
}

S --> UC01
S --> UC02
S --> UC03
S --> UC04
S --> UC05
S --> UC07
S --> UC08
S --> UC09
S --> UC10
S --> UC11

UC04 .> UC05 : <<include>>
UC06 .> UC04 : <<extend>>\n(missing fact)

UC02 --> LLM
UC04 --> LLM
UC05 --> LLM
UC07 --> LLM
UC08 --> LLM

UC01 --> FS
UC09 --> FS
@enduml
