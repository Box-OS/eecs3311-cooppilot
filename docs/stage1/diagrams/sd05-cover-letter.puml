@startuml sd05-cover-letter
title SD05 — Draft Cover Letter (F09)
skinparam shadowing false
autonumber
actor Student
boundary TailorView as TV
control CoopPilotFacade as F
participant VaultService as VS
participant "CoverLetterTask\n<<Template Method>>" as CLT
participant "LLMClient" as LLM
participant ExportService as ES
database ResumeRepository as RR

Student -> TV : click "Write cover letter"
TV -> F : draftCoverLetter(postingId, resumeId)
F -> VS : search(posting keywords, tags)
VS --> F : relevant entries (use = ALL or LETTERS_ONLY)
F -> CLT ** : new CoverLetterTask(posting, resume, entries)
F -> CLT : run()
CLT -> CLT : buildRequest()
CLT -> LLM : complete(request)
LLM --> CLT : letter text
CLT -> CLT : parse(response)
CLT -> CLT : validate(): names company and role,\nstates term length, 250-400 words,\nno CONTEXT_ONLY facts
alt validation fails after retries
  CLT --> F : throws LlmTaskException
  F --> TV : error + last draft for manual editing
else ok
  CLT --> F : CoverLetter
  F -> ES : fileName("CL", company, role)
  ES --> F : "CL_RBC_DataAnalyst"
  F -> RR : save(coverLetter)
  F --> TV : CoverLetter
  TV --> Student : editable letter
end
@enduml
