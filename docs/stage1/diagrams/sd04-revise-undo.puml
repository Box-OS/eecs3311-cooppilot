@startuml sd04-revise-undo
title SD04 — Natural-Language Revision with Undo (F08)
skinparam shadowing false
autonumber
actor Student
boundary TailorView as TV
control CoopPilotFacade as F
participant "RevisionHistory\n<<Invoker>>" as RH
participant "AiRevisionCommand\n<<Command>>" as CMD
participant RevisionTask as RT
participant "LLMClient" as LLM
participant LatexAssembler as LA
participant PageEstimator as PE

Student -> TV : type "make the Tim Hortons bullet\nfocus on teamwork", click Revise
TV -> F : revise(resumeId, instruction)
F -> CMD ** : new AiRevisionCommand(resume, instruction, task)
F -> RH : execute(cmd)
RH -> CMD : execute()
CMD -> RT : run()
RT -> LLM : complete(request)
LLM --> RT : revised resume JSON
RT -> RT : parse + validate (no new facts,\nsame dates and titles)
alt validation fails
  RT --> CMD : throws LlmTaskException
  CMD --> RH : exception
  RH --> F : exception (nothing pushed)
  F --> TV : error, original resume unchanged
else ok
  RT --> CMD : Resume (after)
  CMD -> LA : assemble(after)
  CMD --> RH : after
  RH -> RH : undoStack.push(cmd); redoStack.clear()
  RH --> F : after
  F -> PE : fitsOnePage(after)
  PE --> F : boolean
  F --> TV : after (+ over-page warning)
  TV --> Student : show diff ("What changed")
end

== Undo ==
Student -> TV : click Undo
TV -> F : undo(resumeId)
F -> RH : undo()
alt undoStack empty
  RH --> F : current resume (no-op)
else
  RH -> CMD : undo()
  CMD --> RH : before
  RH -> RH : redoStack.push(cmd)
  RH --> F : before
end
F --> TV : resume
@enduml
