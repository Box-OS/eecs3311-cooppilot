@startuml sd09-cli
title SD09 — CLI: tailor a resume from the terminal (same facade as the GUI)
skinparam shadowing false
autonumber
actor "Student / test harness" as U
boundary "CliRunner\n<<QuestionHandler, AgentEventListener>>" as CLI
control CoopPilotFacade as F
control AgentController as AC

U -> CLI : coop tailor --posting rbc.txt --json
CLI -> CLI : read file
alt file missing
  CLI --> U : exit code 2, "posting file not found"
else
  CLI -> F : addAgentListener(this)
  CLI -> F : importPosting(text)
  F --> CLI : Posting
  CLI -> F : tailorResume(posting.id, this)
  F -> AC : run(goal, cliRunner)
  loop agent steps (see SD01)
    AC -> CLI : onToolCalled(call)
    CLI --> U : stderr: "[step 3] keyword_scan"
    opt agent asks a question (see SD02)
      AC -> CLI : ask(question)  (via AskUserTool)
      CLI --> U : prompt on stdin\n(--no-input returns empty)
    end
  end
  AC --> F : AgentResult
  F --> CLI : AgentResult
  CLI --> U : stdout: JSON {status, resumeName, steps, toolLog}\nexit code 0
end
@enduml
